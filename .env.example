# The local database starts automatically. Set DATABASE_URL only for a separate PostgreSQL instance.
# DATABASE_URL=postgresql://username:password@localhost:5432/tender_tracker
PORT=4310
# Azure production settings (keep DATABASE_URL in App Service configuration).
# NODE_ENV=production
# HOST=0.0.0.0
# PUBLIC_APP_URL=https://tender.cmll.in
# TENDER_STATE_DIR=/home/tender/state
# TENDER_DOCUMENTS_DIR=/home/tender/documents
# DATABASE_URL=postgresql://username:password@server.postgres.database.azure.com:5432/tender_tracker?sslmode=verify-full

# Company OpenID Connect. Register this callback URI with the identity provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4310/api/auth/callback

# Email transport. Leave empty to keep external delivery disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Meta Cloud WhatsApp. Approved template must contain two body parameters: title and message.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANGUAGE=en
WHATSAPP_GRAPH_VERSION=v23.0
